# GNS3 controller (keep this reachable only from this portal host)
GNS3_URL=http://192.168.10.10:3080
# Leave blank only when the controller does not require authentication.
GNS3_USERNAME=admin
GNS3_PASSWORD=change-me

# Local portal access. Set true for the local account, role, and ownership
# controls. The username/password below bootstrap the first Administrator only;
# subsequent users are managed at /admin/users and use password hashes in SQLite.
PORTAL_AUTH_ENABLED=true

# Initial Administrator login. Generate a long random value for
# PORTAL_SECRET_KEY. Keep this password safe: it is used only on first RBAC
# startup, then password changes are performed in the portal.
PORTAL_USERNAME=portaladmin
PORTAL_PASSWORD=change-this-now
PORTAL_SECRET_KEY=replace-with-a-long-random-value

# Server-side login session policy. Sessions end after 30 minutes without a
# portal request or after 8 hours total, whichever comes first. All sessions
# are also invalidated whenever gns3-lab-portal is restarted.
PORTAL_SESSION_IDLE_SECONDS=1800
PORTAL_SESSION_MAX_SECONDS=28800

# Portal database: sqlite (default, single server) or mariadb (required for
# multi-server clusters). Run scripts/setup-mariadb.sh to prepare MariaDB.
PORTAL_DB_BACKEND=sqlite
# SQLite database location (used when PORTAL_DB_BACKEND=sqlite)
AUDIT_DB=./data/audit.db
# MariaDB connection. Host "localhost" uses the local Unix socket.
# PORTAL_DB_HOST=localhost
# PORTAL_DB_PORT=3306
# PORTAL_DB_NAME=gns3_lab_portal
# PORTAL_DB_USER=gns3_portal_app
# PORTAL_DB_PASSWORD_FILE=/etc/gns3-lab-portal/db-app-password
# Optional CA bundle to require TLS to a remote MariaDB server.
# PORTAL_DB_SSL_CA=/etc/gns3-lab-portal/mariadb-ca.pem

# Reverse proxies whose X-Forwarded-For header is trusted for audit source IPs.
PORTAL_TRUSTED_PROXIES=127.0.0.1,::1

# Private profile-photo directory. JPG, PNG, and WebP files are limited to 2 MiB.
PORTAL_AVATAR_DIR=./data/avatars

# Absolute GNS3 projects root. Enables snapshot-size scanning, downloading a
# native backup, and creating a new lab from a selected backup. The portal
# service user needs read/traverse permission to this path.
# GNS3_PROJECTS_DIR=/home/gns3/GNS3/projects

# Optional dedicated disk root for native GNS3 snapshot directories.  Set this
# when using the included migrate-snapshots-to-hdd-store.sh script.
# GNS3_SNAPSHOTS_DIR=/HDD_STORE/gns3-snapshots

# With both paths above configured, new labs created or imported through this
# portal are linked to a dedicated HDD snapshot directory. The www-data service
# account needs write access to newly created project folders and to this HDD
# path; see README before enabling this capability.

# Maximum seconds the portal waits for the GNS3 controller to create a native
# snapshot. The browser uses short status polls instead of one long request.
GNS3_TIMEOUT_SECONDS=3600

# Expected native-snapshot duration in seconds.  This is used only for the
# clearly labelled, five-second progress estimate while GNS3 creates a backup.
SNAPSHOT_ESTIMATED_SECONDS=3600

# One directory for portal-job and GNS3 API diagnostic logs. Create this
# directory and grant write access to the www-data service account before
# enabling the portal service.
PORTAL_LOG_DIR=/var/log/gns3-lab-portal
PORTAL_LOG_RETENTION_DAYS=14
PORTAL_LOG_LEVEL=INFO

# Administrator-only local block-device I/O monitoring.
PORTAL_MONITOR_DISKS=sda,sdb
# Optional: select one registered compute by its UUID when multiple computes exist.
# GNS3_MONITOR_COMPUTE_ID=

# Native backups retained when a lab is deleted with “Keep backups” selected.
RETAINED_BACKUP_DIR=/HDD_STORE/my-lab-retained-backups

# Independent native snapshot archive for published reusable lab templates.
# The portal service account must be able to create and write this directory.
LAB_TEMPLATE_DIR=/HDD_STORE/my-lab-templates
