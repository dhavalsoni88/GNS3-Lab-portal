# v9.0 proposed LDAPS configuration. Do not enable until v9.0 implementation.
# Plain LDAP is deliberately unsupported.
PORTAL_LDAP_ENABLED=false
PORTAL_LDAP_URL=ldaps://ad.example.internal:636
PORTAL_LDAP_CA_CERT_FILE=/etc/gns3-lab-portal/ldap-ca.pem
PORTAL_LDAP_BIND_DN=CN=gns3-portal-reader,OU=Service Accounts,DC=example,DC=internal
PORTAL_LDAP_BIND_PASSWORD_FILE=/etc/gns3-lab-portal/ldap-bind-password
PORTAL_LDAP_USER_BASE_DN=OU=Users,DC=example,DC=internal
PORTAL_LDAP_GROUP_BASE_DN=OU=Groups,DC=example,DC=internal
PORTAL_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
PORTAL_LDAP_GROUP_FILTER=(objectClass=group)
